# Local data directory: database plus sanitized uploads.
DATA_DIR=./data

# Absolute base used for public-page links and exports.
SITE_URL=http://localhost:3000

# Optional. When set, the workspace routes require a passphrase.
# The public page and /p/[slug] stay public.
# WORKSPACE_PASSPHRASE=

# Required when WORKSPACE_PASSPHRASE is set. Signs the session cookie.
# AUTH_SECRET=
